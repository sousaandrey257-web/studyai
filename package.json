{
  "name": "studyai",
  "version": "1.0.0",
  "description": "Micro-SaaS de révision étudiante avec IA",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:security": "node tests/security.test.js",
    "validate:env": "node -e \"require('./services/startup/envValidator').validate()\"",
    "backup": "node -e \"require('./services/backup/autoBackup').runBackup()\"",
    "restore": "node scripts/restore.js",
    "docker:build": "docker build -t studyai .",
    "docker:run": "docker compose up -d",
    "docker:stop": "docker compose down",
    "smoke-test": "node scripts/smoke-test.js",
    "checklist": "node scripts/checklist.js",
    "beta:codes": "node -e \"const I=require('./services/beta/inviteCodes');const c=I.generateBatch(10);c.forEach(x=>console.log(x));\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.52.7",
    "stripe": "^16.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "puppeteer": "^24.43.0"
  },
  "optionalDependencies": {
    "bullmq": "^5.7.0",
    "ioredis": "^5.3.2"
  }
}
