# ============================================================
#  StudyAI — Variables d'environnement pour Railway (PRODUCTION)
#  Copier-coller dans Railway > Variables
#  Ne jamais committer ce fichier avec de vraies valeurs
# ============================================================

# ── OBLIGATOIRE — sans ça le serveur crash ou le paiement échoue ──────────────

# JWT : sessions utilisateurs (générer avec : openssl rand -hex 32)
JWT_SECRET=REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_64_CHARS

# Clé admin (générer avec : openssl rand -hex 32)
ADMIN_KEY=REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_32_CHARS

# IA Groq (prioritaire — gratuit) : https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# IA OpenAI (fallback si Groq absent) : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Stripe — clés LIVE (mode live, vrais paiements) : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Webhook — depuis Dashboard Stripe > Webhooks > Signing secret
# ⚠️ Ce n'est PAS le whsec_ de "stripe listen" (ça c'est pour le local)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── RECOMMANDÉ — warnings au démarrage si absent ─────────────────────────────

# Mode production (active le rate-limit strict + masque les erreurs internes)
NODE_ENV=production

# URL publique du site Railway (pour success_url/cancel_url Stripe + sitemap)
SITE_URL=https://studyai-production-5202.up.railway.app

# CORS — origines autorisées (ta vraie URL Railway)
ALLOWED_ORIGINS=https://studyai-production-5202.up.railway.app

# Super admin — seul cet email a accès aux routes /api/admin/*
SUPER_ADMIN_EMAIL=ton-email@example.com

# ── OPTIONNEL — mode dégradé si absent ───────────────────────────────────────

# Port (Railway le fournit automatiquement)
PORT=3000

# Redis — classement + queues (Railway > Add service > Redis)
REDIS_URL=redis://...

# Stripe Price IDs — si tu as des produits pré-créés dans Dashboard Stripe
# Sinon le mode price_data dynamique est utilisé automatiquement
# MONTHLY_PRICE_ID=price_...
# YEARLY_PRICE_ID=price_...
# LIFETIME_PRICE_ID=price_...

# Modèle IA (défaut : llama-3.3-70b-versatile pour Groq, gpt-4o-mini pour OpenAI)
# OPENAI_MODEL=llama-3.3-70b-versatile

# Email transactionnel (mot de passe oublié, etc.)
# Choisir un seul fournisseur :
# POSTMARK_API_KEY=...
# RESEND_API_KEY=...
# SENDGRID_API_KEY=...
# FROM_EMAIL=noreply@studyai.app
