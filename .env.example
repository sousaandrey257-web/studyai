# ============================================================
#  StudyAI — Configuration
# ============================================================

# --- OPTION A : OpenAI (payant, ~$5 minimum de crédits) ---
# Obtenir sur https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- OPTION B : Groq (GRATUIT, recommandé pour démarrer) ---
# Obtenir sur https://console.groq.com/keys (gratuit, sans CB)
GROQ_API_KEY=gsk_...

# Si les deux sont définis, Groq est prioritaire (gratuit)

# --- Modèle IA (optionnel) ---
# OpenAI : gpt-4o-mini (défaut), gpt-4o
# Groq   : llama-3.3-70b-versatile (défaut), llama3-8b-8192, mixtral-8x7b-32768
# OPENAI_MODEL=gpt-4o-mini

# --- Stripe (optionnel — paiement Premium) ---
# Clé secrète : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Secret du webhook Stripe (pour vérifier les events entrants)
# Obtenir dans : Dashboard Stripe → Developers → Webhooks → ton endpoint → Signing secret
# Laisser vide en développement local (non vérifié)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs Stripe — copier depuis Dashboard Stripe > Produits > Prix
# Si vides : price_data dynamique (multi-devises) est utilisé comme fallback
# MONTHLY_PRICE_ID=price_...
# YEARLY_PRICE_ID=price_...
# LIFETIME_PRICE_ID=price_...

# Origines autorisées pour CORS (séparées par virgule)
# ALLOWED_ORIGINS=https://studyai.app,https://www.studyai.app

# --- Port (3000 par défaut) ---
PORT=3000

# --- Super Admin (obligatoire en production) ---
# Seul cet email peut accéder aux routes /api/admin/* via JWT
# Ne jamais exposer ni committer cette valeur
SUPER_ADMIN_EMAIL=your-email@example.com

# --- Clé admin locale (accès alternatif sans JWT) ---
# Générée via : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_KEY=...
